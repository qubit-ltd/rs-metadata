{
  "version": 4,
  "expression": {
    "kind": "and",
    "children": [
      { "kind": "exists", "key": "status" },
      {
        "kind": "not",
        "expression": { "kind": "not_exists", "key": "deleted_at" }
      }
    ]
  },
  "options": { "numeric_comparison_policy": "exact" },
  "limits": {
    "max_depth": 64,
    "max_nodes": 256,
    "max_set_values": 128,
    "max_key_bytes": 256
  }
}
